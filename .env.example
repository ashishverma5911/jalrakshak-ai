# JalRakshak AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit real secrets or credentials to version control.

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
PORT=8000
HOST=0.0.0.0

# ==========================================
# Database Configuration (PostgreSQL / PostGIS)
# ==========================================
POSTGRES_DB=jalrakshak
POSTGRES_USER=jalrakshak_user
POSTGRES_PASSWORD=your_secure_local_password
DATABASE_URL=postgresql+psycopg://jalrakshak_user:your_secure_local_password@localhost:5432/jalrakshak

# Allowed CORS origins (comma-separated list, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Telemetry freshness threshold in hours (data older than this triggers a stale warning)
DATA_STALENESS_HOURS=24.0

# Maximum user question character length for assistant input validation
MAX_QUERY_LENGTH=1000

# ==========================================
# Scientific Data Ingestion Credentials
# ==========================================
# NASA Earthdata URS credentials (required for live NASA GPM IMERG Late Run feeds)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_BEARER_TOKEN=

# Open-Meteo API key (optional for open tier; required for high-throughput commercial access)
OPEN_METEO_API_KEY=

# Base endpoint URLs
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0

# ==========================================
# Ingestion Security & Upload Authentication
# ==========================================
# Secret API key required to upload datasets, inspect upload history, or trigger quarantine cleanup.
# Set a strong random secret in production (e.g. openssl rand -hex 32).
# Can be supplied by clients via 'X-API-Key: <key>' or 'Authorization: Bearer <key>'
UPLOAD_API_KEY=your_secure_upload_api_key_here

# ==========================================
# Gemma 4 Local Inference Adapter Settings
# ==========================================
# URL for local Ollama / Gemma 4 inference server
GEMMA_API_URL=http://localhost:11434/api/generate
GEMMA_MODEL_NAME=gemma:4

# Optional API token if proxying through an authenticated local gateway
GEMMA_API_KEY=

# Maximum seconds to await local model response before switching to deterministic fallback
GEMMA_TIMEOUT_SECONDS=3.0

# ==========================================
# Frontend Configuration (Vite + React)
# ==========================================
# Base URL for API endpoints. In local development Vite proxies /api to http://localhost:8000
VITE_API_BASE_URL=/api/v1

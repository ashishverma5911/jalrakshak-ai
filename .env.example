# JalRakshak AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit real secrets or credentials to version control.

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
PORT=8000
HOST=0.0.0.0

# Allowed CORS origins (comma-separated list, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Telemetry freshness threshold in hours (data older than this triggers a stale warning)
DATA_STALENESS_HOURS=24.0

# Maximum user question character length for assistant input validation
MAX_QUERY_LENGTH=1000

# ==========================================
# Gemma 4 Local Inference Adapter Settings
# ==========================================
# URL for local Ollama / Gemma 4 inference server
GEMMA_API_URL=http://localhost:11434/api/generate
GEMMA_MODEL_NAME=gemma:4

# Optional API token if proxying through an authenticated local gateway
GEMMA_API_KEY=

# Maximum seconds to await local model response before switching to deterministic fallback
GEMMA_TIMEOUT_SECONDS=3.0

# ==========================================
# Frontend Configuration (Vite + React)
# ==========================================
# Base URL for API endpoints. In local development Vite proxies /api to http://localhost:8000
VITE_API_BASE_URL=/api/v1
